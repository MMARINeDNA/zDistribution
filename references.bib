@phdthesis{Crance2008,
  title = {Changes in Killer Whale, {{Orcinus}} Orca, Stereotyped Call Repertoires as a Function of Time and Social Association},
  author = {Crance, Jessica Lynne},
  year = 2008,
  abstract = {Killer whales have highly stable, long-term social groupings based on matrilines. They have vocal dialects that remain stable over long periods and are thought to be an important mechanism for maintaining group cohesion. The repertoire of calls that forms the dialect is apparently used by all members of the group, but data from wild whales are not adequate to determine whether all members of a pod use all calls, whether there are social factors determining call usage, whether individual as well as group information is encoded, and how changes in the dialect develop when social groups change. This thesis explores the acoustic characteristics of individual vocal repertoires and repertoire change over time under controlled conditions. The purpose of the study was three-fold. The first was to determine whether individual-specific information could be identified in the acoustic features of killer whale stereotyped pulsed calls under controlled conditions in an oceanarium. Second, the study quantified change in the stereotyped call repertoires of killer whales over time, and determined whether a learning window, or sensitive period, might be present in killer whales. Finally, the effects of social association on vocal repertoires were examined. The subjects were six killer whales at SeaWorld San Diego; three adult females, one juvenile male, one subadult male, and one adult male. The juvenile was the son of one of the adult females. Simultaneous acoustic and behavioral data were collected from September 2001 to November 2006, with a one year xiii collection hiatus in 2004. All data were split into two time periods, 2001-2003 and 2005-2006. Vocalizations were attributed to individual whales and calls were categorized by ear with {$>$}97\% accuracy. Acoustic measurements were conducted on components of the two most commonly shared stereotyped pulsed call types. Association among whales was determined based on the amount of time pairs of whales spent in synchronous swimming. Discriminant analysis revealed individually unique frequency modulation of the high frequency component (HFC), which could distinguish among calls of individual whales with {$>$}91\% accuracy. However, the low-frequency component (LFC) was poorly distinguished among whales for both time periods. This suggests that both individual- and group-specific information are present in the stereotyped pulsed call. Cluster analysis was conducted to determine the amount of repertoire overlap by calculating the squared Euclidean linkage distance of the repertoires of each pairwise combination. Results from the cluster analysis revealed that the two dominant females, strongly associated with each other throughout the entire study period, had the greatest repertoire similarity for both time periods. The third adult female associated with others infrequently, and her repertoire was dissimilar to those of all other whales during both time periods. During the study period, the juvenile male became emancipated from his mother. While he and the other two males spent little time together in the first study period, they spent a majority of their time together in the second. Concurrent with this increase in association, the males demonstrated call matching and repertoire convergence. Cluster analysis and similarity indices revealed the males' xiv xv repertoires were more similar to each other than to those of the dominant females. Linear regression produced a significant (p=0.005) negative trend, showing that smaller linkage distances, and thus more similar repertoires, were found in whales that associated more often. Although the two young males continued to learn new calls and alter their repertoires during the five years of the study, repertoires of all four adult whales either remained relatively stable or decreased in size during the study period. Although evidence was found in the calls of the adult male of matching to a call type of the younger males, the match was poor and specimens of the call were uncommon (5 of 474 calls by the adult male). On the other hand, the young males produced many instances of unique calls in the adult male's repertoire. The results of this study suggest that the stereotyped pulsed calls have a dual function, identifying a whale at both the individual- and the group-level. Furthermore, the results suggest that a sensitive period exists for killer whales. Although the duration of the study was not sufficient to document the transition of the younger whales' repertoires from plastic to fixed, the large changes in their repertoires contrasted strongly with the fixed repertoires of the adults. Therefore, it is possible that stereotyped pulsed call repertoires of killer whales become fixed sometime after reaching maturity. Changes in repertoires were correlated with association, suggesting that social bonds are an important determinant of vocal repertoire change; the more strongly associated are individuals, the more similar their repertoires.},
  school = {University of San Diego},
  file = {C:\Users\Amy Van Cise\Zotero\storage\QXAE5DHE\2008-Changes_in_killer_whale_Orcinus_orca_stereotyped_call_repertoires_as_a_function_of_time_and_social_association.pdf}
}

