@article{Watkinson1984,
  title = {Yield-Density Relationships: {{The}} Influence of Resource Availability on Growth and Self-Thinning in Populations of {{Vulpia}} Fasciculata},
  author = {Watkinson, a. R.},
  year = 1984,
