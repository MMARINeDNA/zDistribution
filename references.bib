@article{Kraft2020,
  ids = {Kraft2020a,kraftGlobalPhylogeographyGenetic2020,kraftGlobalPhylogeographyGenetic2020a},
  title = {Global Phylogeography and Genetic Diversity of the Long-Finned Pilot Whale {{Globicephala}} Melas, with New Data from the Southeastern {{Pacific}}},
  author = {Kraft, Sebasti{\'a}n and {P{\'e}rez-{\'A}lvarez}, {\relax Mj}os{\'e} and Olavarr{\'i}a, Carlos and Poulin, Elie},
  year = 2020,
