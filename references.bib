@article{morin_etal21,
  ids = {Morin2021b},
  title = {Reference Genome and Demographic History of the Most Endangered Marine Mammal, the Vaquita},
  author = {Morin, Phillip A. and Archer, Frederick I. and Avila, Catherine D. and Balacco, Jennifer R. and Bukhman, Yury V. and Chow, William and Fedrigo, Olivier and Formenti, Giulio and Fronczek, Julie A. and Fungtammasan, Arkarachai and Gulland, Frances M. D. and Haase, Bettina and {Peter Heide-Jorgensen}, Mads and Houck, Marlys L. and Howe, Kerstin and Misuraca, Ann C. and Mountcastle, Jacquelyn and Musser, Whitney and Paez, Sadye and Pelan, Sarah and Phillippy, Adam and Rhie, Arang and Robinson, Jacqueline and {Rojas-Bracho}, Lorenzo and Rowles, Teri K. and Ryder, Oliver A. and Smith, Cynthia R. and Stevenson, Sacha and Taylor, Barbara L. and Teilmann, Jonas and Torrance, James and Wells, Randall S. and Westgate, Andrew J. and Jarvis, Erich D.},
  year = 2021,
  journal = {Molecular Ecology Resources},
  volume = {21},
  number = {4},
  pages = {1008--1020},
  issn = {1755-0998},
  doi = {10.1111/1755-0998.13284},
  urldate = {2022-01-31},
  abstract = {The vaquita is the most critically endangered marine mammal, with fewer than 19 remaining in the wild. First described in 1958, the vaquita has been in rapid decline for more than 20 years resulting from inadvertent deaths due to the increasing use of large-mesh gillnets. To understand the evolutionary and demographic history of the vaquita, we used combined long-read sequencing and long-range scaffolding methods with long- and short-read RNA sequencing to generate a near error-free annotated reference genome assembly from cell lines derived from a female individual. The genome assembly consists of 99.92\% of the assembled sequence contained in 21 nearly gapless chromosome-length autosome scaffolds and the X-chromosome scaffold, with a scaffold N50 of 115 Mb. Genome-wide heterozygosity is the lowest (0.01\%) of any mammalian species analysed to date, but heterozygosity is evenly distributed across the chromosomes, consistent with long-term small population size at genetic equilibrium, rather than low diversity resulting from a recent population bottleneck or inbreeding. Historical demography of the vaquita indicates long-term population stability at less than 5,000 (Ne) for over 200,000 years. Together, these analyses indicate that the vaquita genome has had ample opportunity to purge highly deleterious alleles and potentially maintain diversity necessary for population health.},
  langid = {english},
  pmid = {33089966},
  keywords = {Conservation genomics,genome diversity,historical demography,Phocoena sinus,porpoise,Vertebrate Genomes Project},
  file = {C\:\\Users\\Amy Van Cise\\Zotero\\storage\\5DJQFYVK\\full-text.pdf;C\:\\Users\\Amy Van Cise\\Zotero\\storage\\JFKD644F\\Morin et al. - 2021 - Reference genome and demographic history of the mo.pdf;C\:\\Users\\Amy Van Cise\\Zotero\\storage\\4Z4FTCFE\\1755-0998.html}
}

@article{morin_etal24,
  title = {Revised Taxonomy of Eastern {{North Pacific}} Killer Whales ({{Orcinus}} Orca): {{Bigg}}'s and Resident Ecotypes Deserve Species Status},
  shorttitle = {Revised Taxonomy of Eastern {{North Pacific}} Killer Whales ({{Orcinus}} Orca)},
  author = {Morin, Phillip A. and McCarthy, Morgan L. and Fung, Charissa W. and Durban, John W. and Parsons, Kim M. and Perrin, William F. and Taylor, Barbara L. and Jefferson, Thomas A. and Archer, Frederick I.},
  year = 2024,
  month = mar,
  journal = {Royal Society Open Science},
  volume = {11},
  number = {3},
  pages = {231368},
  publisher = {Royal Society},
  doi = {10.1098/rsos.231368},
  urldate = {2024-04-03},
  abstract = {Killer whales (Orcinus orca) are currently recognized as a single ecologically and morphologically diverse, globally distributed species. Multiple morphotypes or ecotypes have been described, often associated with feeding specialization, and several studies have suggested taxonomic revision to include multiple subspecies or species in the genus. We review the ecological, morphological and genetic data for the well-studied `resident' and Bigg's (aka `transient') ecotypes in the eastern North Pacific and use quantitative taxonomic guidelines and standards to determine whether the taxonomic status of these killer whale ecotypes should be revised. Our review and new analyses indicate that species-level status is justified in both cases, and we conclude that eastern North Pacific Bigg's killer whales should be recognized as Orcinus rectipinnus (Cope in Scammon, 1869) and resident killer whales should be recognized as Orcinus ater (Cope in Scammon, 1869).},
  keywords = {Cetacea,odontocete,speciation},
  file = {C:\Users\Amy Van Cise\Zotero\storage\C9D9QIH9\Morin et al. - 2024 - Revised taxonomy of eastern North Pacific killer w.pdf}
}

@article{morin_etal25,
  title = {Genomic Infrastructure for Cetacean Research and Conservation: Reference Genomes for Eight Families Spanning the Cetacean Tree of Life},
  shorttitle = {Genomic Infrastructure for Cetacean Research and Conservation},
  author = {Morin, Phillip A. and Bein, Bernhard and Bortoluzzi, Chiara and Bukhman, Yury V. and Hains, Taylor and Heimeier, Dorothea and {Uliano-Silva}, Marcela and Absolon, Dominic E. and Abueg, Linelle and {Antosiewicz-Bourget}, Jessica and Balacco, Jennifer R. and Bonde, Robert K. and Brajuka, Nadolina and Brownlow, Andrew C. and Carroll, Emma L. and Carter, Molly and Collins, Joanna and Davison, Nicholas J. and Denton, Amy and Fedrigo, Olivier and Foote, Andrew D. and Formenti, Giulio and Gallo, Guido R. and Greve, Carola and Houck, Marlys L. and Howard, Caroline and Jacobsen, Jeff K. and Jain, Nivesh and Krasheninnikova, Ksenia and Maloney, Brigid M. and Manley, Bethan F. and Mathers, Thomas C. and Mccarthy, Shane A. and Mcgowen, Michael R. and Meyer, Susanne and Mountcastle, Jacquelyn and Neely, Benjamin A. and O'toole, Brian and Pelan, Sarah and Rosel, Patricia E. and Rowles, Teri K. and Ryder, Oliver A. and Schell, Tilman and Sims, Ying and St Leger, Judy and Stewart, Ron and Ternes, Kerstin and Tilley, Tatiana and Whelan, Conor and Wood, Jonathan M. D. and Hiller, Michael and Blaxter, Mark and Jarvis, Erich D.},
  year = 2025,
  month = jul,
  journal = {Frontiers in Marine Science},
  volume = {12},
  publisher = {Frontiers},
  issn = {2296-7745},
  doi = {10.3389/fmars.2025.1562045},
  urldate = {2025-07-10},
  abstract = {Reference genomes from representative species across families provide the critical infrastructure for research and conservation. The Cetacean Genomes Project (CGP) began in early 2020 to facilitate the generation of near error-free, chromosome-resolved reference genomes for all cetacean species. Towards that goal, and using the methods, goals and genome assembly quality standards of the Vertebrate Genomes Project (VGP), we generated 13 new reference genomes across eight of the 14 cetacean families. Additionally, we summarize the genome assembly characteristics for 18 species, including these newly-generated and five published genome assemblies that meet the completeness and quality standards. We infer ancestral linkage groups (ALG) for cetaceans, showing that the ancestral karyotype of 22 ALGs is largely conserved in extant species, except for Ziphiidae, and for Balaenidae and Kogiidae, which exhibit similar independent fusions. Gene annotation, characterization of historical demography, heterozygosity and runs of homozygosity (ROH) reveal important information for conservation applications. By comparing the new reference genomes to previous draft assemblies, we show that the reference genomes have enhanced characteristics that will support and promote scientific research. Specifically, the genomes improve resolution and characterization of repetitive elements, provide validation (or exclusion) of genes linked to complex traits, and allow more complete characterization of gene regions such as the highly complex Major Histocompatibility Complex (MHC) Class I and II gene clusters that are important for population health.},
  langid = {english},
  keywords = {Cetacea,comparative genomics,conservation genomics,dolphin,porpoise,reference genome,whale},
  file = {C:\Users\Amy Van Cise\Zotero\storage\8HGQU5ZQ\Morin et al. - 2025 - Genomic infrastructure for cetacean research and c.pdf}
}

