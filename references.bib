@article{Mangano2014,
  title = {Metal and Antibiotic Resistance in Psychrotrophic Bacteria Associated with the {{Antarctic}} Sponge {{Hemigellius}} Pilosus ({{Kirkpatrick}}, 1907)},
  author = {Mangano, Santina and Michaud, Luigi and Caruso, Consolazione and Lo Giudice, Angelina},
  year = 2014,
