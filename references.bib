  ids = {marquesEstimatingNorthPacific2011},
  title = {Estimating North Pacific Right Whale {{{\emph{Eubalaena}}}}{\emph{ Japonica}} Density Using Passive Acoustic Cue Counting},
  author = {Marques, Tiago A. and Munger, Lisa and Thomas, Len and Wiggins, Sean and Hildebrand, John A.},
