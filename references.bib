@article{Matkin2014,
  title = {Life History and Population Dynamics of Southern {{Alaska}} Resident Killer Whales ({{{\emph{Orcinus}}}}{\emph{ Orca}})},
  author = {Matkin, Craig O. and Ward Testa, J. and Ellis, Graeme M. and Saulitis, Eva L.},
  year = 2014,
