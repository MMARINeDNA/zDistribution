@article{BISCHOFF2012,
  title = {Deep-Sea and Pelagic Rod Visual Pigments Identified in the Mysticete Whales},
  author = {BISCHOFF, {\relax NICOLE} and NICKLE, {\relax BENJAMIN} and CRONIN, THOMAS W. and VELASQUEZ, {\relax STEPHANI} and FASICK, JEFFRY I.},
  year = 2012,
  month = mar,
  journal = {Visual Neuroscience},
  volume = {29},
  number = {02},
  pages = {95--103},
  publisher = {Cambridge University Press},
  issn = {0952-5238},
  doi = {10.1017/S0952523812000107},
  urldate = {2018-09-22},
  abstract = {{$<$}p{$>$} Our current understanding of the spectral sensitivities of the mysticete whale rod-based visual pigments is based on two species, the gray whale ( {$<$}italic{$>$}Eschrichtius robustus{$<$}/italic{$>$} ) and the humpback whale ( {$<$}italic{$>$}Megaptera novaeangliae{$<$}/italic{$>$} ) possessing absorbance maxima determined from difference spectra to be 492 and 497 nm, respectively. These absorbance maxima values are blueshifted relative to those from typical terrestrial mammals ({$\approx$}500 nm) but are redshifted when compared to those identified in the odontocetes (479--484 nm). Although these mysticete species represent two of the four mysticete families, they do not fully represent the mysticete whales in terms of foraging strategy and underwater photic environments where foraging occurs. In order to better understand the spectral sensitivities of the mysticete whale rod visual pigments, we have examined the rod opsin genes from 11 mysticete species and their associated amino acid substitutions. Based on the amino acids occurring at positions 83, 292, and 299 along with the directly determined dark spectra from expressed odontocete and mysticete rod visual pigments, we have determined that the majority of mysticete whales possess deep-sea and pelagic like rod visual pigments with absorbance maxima between 479 and 484 nm. Finally, we have defined the five amino acid substitution events that determine the resulting absorbance spectra and associated absorbance maxima for the mysticete whale rod visual pigments examined here. {$<$}/p{$>$}},
  keywords = {Absorbance spectra,Amino acid substitution,Baleen,Cetacean,Opsin}
}

@article{Bittencourt2018,
  title = {Mapping Cetacean Sounds Using a Passive Acoustic Monitoring System Towed by an Autonomous {{Wave Glider}} in the {{Southwestern Atlantic Ocean}}},
  author = {Bittencourt, Lis and {Soares-Filho}, William and {de Lima}, Isabela Maria Seabra and Pai, Sudhir and {Lailson-Brito}, Jose and Barreira, Leonardo Martins and Azevedo, Alexandre Freitas and Guerra, Luiz Alexandre A.},
  year = 2018,
  month = oct,
  journal = {Deep Sea Research Part I: Oceanographic Research Papers},
  publisher = {Pergamon},
  issn = {0967-0637},
  doi = {10.1016/J.DSR.2018.10.006},
  urldate = {2018-11-07},
  abstract = {Passive acoustic monitoring techniques provide a useful alternative to visual surveys for monitoring of marine mammals since they are less affected by adverse weather conditions. An autonomous unmanned Wave Glider, equipped with a towed hydrophone and recording system was used to collect acoustic data in the Brazilian offshore waters of the Southwestern Atlantic Ocean between 6 and 25 February 2016. Nearly continuous data were obtained during this period (light and dark hours) for the 750\,km traveled. There were 165,130 high-frequency detections in 31 encounters, including 1789 whistles, 389 burst-pulse sounds, and 162,952 echolocation clicks. A total of 705 low-frequency tonal signals were recorded in 5 encounters. Although high-frequency detections occurred at all hours of the day, the majority occurred during dark hours. Low-frequency detections were not evenly spread through all hours of the day, with the majority of them occurring during dark hours. High-frequency and low-frequency detections represented 26\% and 3\% of the recording hours, respectively. Duration, the number of emissions, and ocean depth varied among acoustic encounters. Encounters composed by high-frequency sounds were separated into seven different groups, probably different species. One of the encounters presented whistles that were previously recorded in the Rio de Janeiro Coast for Steno bredanensis (Rough-toothed dolphins). All of the low-frequency encounters were composed of a type of Balaenoptera brydei (Bryde's whales) call. This type of data collection is un-precedented for the Southwestern Atlantic Ocean and highlighted the use of the sampled area by delphinids on different days and different times of the day, including the dark hours.},
  file = {C:\Users\Amy Van Cise\Zotero\storage\WLZJYEMH\full-text.pdf}
}

@article{blain_etal07,
  title = {Effect of Natural Iron Fertilization on Carbon Sequestration in the {{Southern Ocean}}},
  author = {Blain, St{\'e}phane and Qu{\'e}guiner, Bernard and Armand, Leanne and Belviso, Sauveur and Bombled, Bruno and Bopp, Laurent and Bowie, Andrew and Brunet, Christian and Brussaard, Corina and Carlotti, Fran{\c c}ois and Christaki, Urania and Corbi{\`e}re, Antoine and Durand, Isabelle and Ebersbach, Frederike and Fuda, Jean-Luc and Garcia, Nicole and Gerringa, Loes and Griffiths, Brian and Guigue, Catherine and Guillerm, Christophe and Jacquet, St{\'e}phanie and Jeandel, Catherine and Laan, Patrick and Lef{\`e}vre, Dominique and Lo Monaco, Claire and Malits, Andrea and Mosseri, Julie and Obernosterer, Ingrid and Park, Young-Hyang and Picheral, Marc and Pondaven, Philippe and Remenyi, Thomas and Sandroni, Val{\'e}rie and Sarthou, G{\'e}raldine and Savoye, Nicolas and Scouarnec, Lionel and Souhaut, Marc and Thuiller, Doris and Timmermans, Klaas and Trull, Thomas and Uitz, Julia and {van Beek}, Pieter and Veldhuis, Marcel and Vincent, Doroth{\'e}e and Viollier, Eric and Vong, Lilita and Wagener, Thibaut},
  year = 2007,
  month = apr,
  journal = {Nature},
  volume = {446},
  number = {7139},
  pages = {1070--1074},
  publisher = {Nature Publishing Group},
  issn = {1476-4687},
  doi = {10.1038/nature05700},
  urldate = {2023-05-08},
  abstract = {The growth of microalgae in seawater is an important factor in determining climate as it converts atmospheric carbon dioxide into organic material that can be transported to and stored in the deep sea. This process is inhibited in the Southern Ocean by a lack of iron; this ocean is virtually a biological desert. To date, the role of iron in carbon cycling has largely been assessed using short-term iron-addition experiments. Now analysis of data from the 'KEOPS I' cruise of the research vessel Marion Dufresne has provided insights into carbon cycling from an 'oasis' in that desert --- a phytoplankton bloom induced by iron supplied from the waters below. The efficiency of this natural fertilization is at least ten times higher than estimates from short-term experiments. This suggests that natural changes in iron supply to the ocean surface due to changes in upwelling may have a greater effect on atmospheric carbon dioxide than was thought.},
  copyright = {2007 Nature Publishing Group},
  langid = {english},
  keywords = {Humanities and Social Sciences,multidisciplinary,Science},
  file = {C:\Users\Amy Van Cise\Zotero\storage\KYNGQFRI\Blain et al. - 2007 - Effect of natural iron fertilization on carbon seq.pdf}
}

