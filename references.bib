@article{yang_etal23,
  title = {Estimating the {{Spatial Distribution}} and {{Future Conservation Requirements}} of the {{Spotted Seal}} in the {{North Pacific}}},
  author = {Yang, Leyu and Zhuang, Hongfei and Liu, Shenghao and Cong, Bailin and Huang, Wenhao and Li, Tingting and Liu, Kaiyu and Zhao, Linlin},
  year = 2023,
