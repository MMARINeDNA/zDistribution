  keywords = {Blood Preservation,Breast Neoplasms,Cryopreservation,Drug Stability,Estradiol,Female,Humans,Plasma,Progesterone,Prolactin,Prospective Studies,Reproducibility of Results,Testosterone,Time Factors}
}

