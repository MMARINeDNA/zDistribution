  author = {Papale, E. and Azzolin, M. and Casc{\~a}o, I. and Gannier, A. and Lammers, M.O. and Martin, V.M. and Oswald, J. and {Perez-Gil}, M. and Prieto, R. and Silva, M.A. and Giacoma, C.},
  year = 2014,
