@article{cooke_etal01,
  title = {Physiological Performance of Largemouth Bass Related to Local Adaptation and Interstock Hybridization: Implications for Conservation and Management},
  author = {Cooke, S. J. and Kassler, T. W. and Philipp, D. P.},
  year = 2001,
  month = dec,
  journal = {Journal of Fish Biology},
  volume = {59},
  number = {sa},
  pages = {248--268},
  publisher = {Wiley},
  issn = {0022-1112},
  doi = {10.1111/j.1095-8649.2001.tb01389.x},
  urldate = {2020-10-28},
  abstract = {Four genetically distinct stocks of age 2+ years largemouth bass Micropterus salmoides were produced using adults collected from two regions in the upper midwest (central Illinois, IL and south-eastern Wisconsin, WI, U.S.A.). Two pure stocks (IL \texttimes{} IL and WI \texttimes{} WI), as well as both of their reciprocal F1 interstock hybrids (IL \texttimes{} WI and WI \texttimes{} IL) were produced in research ponds in Champaign, IL. In general, swimming performance, routine oxygen consumption and activity were highest at 18 \texttimes{} C, intermediate at 12 \texttimes{} C, and lowest at 6. C for all stocks. However, performance indicators varied among stocks at each of the temperatures. The pure Illinois stock (IL \texttimes{} IL) had the lowest activity: cost ratio at 18 \texttimes{} C and the highest at 6\_ C (based upon swimming strength, routine activity rates and routine metabolic rates). The opposite pattern was observed for the other pure stock (WI \texttimes{} WI). Although differences were less distinct at lower temperatures, the two pure stocks (IL \texttimes{} IL and WI \texttimes{} WI) outperformed both interstock hybrids. These results indicate that not only do non-native stocks appear to have reduced performance relative to locally adapted stocks, but also that interstock hybrids exhibit performance impairments, not hybrid vigour.},
  keywords = {adaptation,conservation,Micropterus salmoides,outbreeding depression,performance,physiology,stocking}
}

