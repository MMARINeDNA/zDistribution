@article{akamatsu_etal07,
  title = {Comparison of Echolocation Behaviour between Coastal and Riverine Porpoises},
  author = {Akamatsu, Tomonari and Teilmann, Jonas and Miller, Lee A. and Tougaard, Jakob and Dietz, Rune and Wang, Ding and Wang, Kexiong and Siebert, Ursula and Naito, Yasuhiko},
