@article{albery_etal24a,
  title = {Expanding Theory, Methodology and Empirical Systems at the Spatial--Social Interface},
  author = {Albery, Gregory F. and Webber, Quinn M. R. and Farine, Damien and Picardi, Simona and Vander Wal, Eric and Manlove, Kezia R.},
  year = 2024,
