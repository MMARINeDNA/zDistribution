  ids = {blakeyTerrestrialLaserScanning2017},
  title = {Terrestrial Laser Scanning Reveals Below-Canopy Bat Trait Relationships with Forest Structure},
  author = {Blakey, Rachel V. and Law, Brad S. and Kingsford, Richard T. and Stoklosa, Jakub},
  year = 2017,
