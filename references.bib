@article{Guerra2011,
  title = {Quantifying Seismic Survey Reverberation off the {{Alaskan North Slope}}.},
  author = {Guerra, Melania and Thode, Aaron M and Blackwell, Susanna B and Michael Macrander, a},
  year = 2011,
  month = nov,
  journal = {The Journal of the Acoustical Society of America},
  volume = {130},
