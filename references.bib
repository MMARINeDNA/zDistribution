@article{Deecke2005,
  title = {The Vocal Behaviour of Mammal-Eating Killer Whales: Communicating with Costly Calls},
  author = {Deecke, Volker B. and Ford, John K.B. and Slater, Peter J.B.},
  year = 2005,
