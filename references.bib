@article{lilienthal_etal06,
  title = {Effects of Developmental Exposure to 2,2 ,4,4 ,5-Pentabromodiphenyl Ether ({{PBDE-99}}) on Sex Steroids, Sexual Development, and Sexually Dimorphic Behavior in Rats},
