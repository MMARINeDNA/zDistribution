@article{wignall_taylor11,
  title = {Assassin Bug Uses Aggressive Mimicry to Lure Spider Prey},
  author = {Wignall, Anne E. and Taylor, Phillip W.},
  year = 2011,
  month = may,
  journal = {Proceedings of the Royal Society B: Biological Sciences},
  volume = {278},
  number = {1710},
  pages = {1427--1433},
  publisher = {Royal Society},
  doi = {10.1098/rspb.2010.2060},
  urldate = {2022-02-02},
  abstract = {Assassin bugs (Stenolemus bituberus) hunt web-building spiders by invading the web and plucking the silk to generate vibrations that lure the resident spider into striking range. To test whether vibrations generated by bugs aggressively mimic the vibrations generated by insect prey, we compared the responses of spiders to bugs with how they responded to prey, courting male spiders and leaves falling into the web. We also analysed the associated vibrations. Similar spider orientation and approach behaviours were observed in response to vibrations from bugs and prey, whereas different behaviours were observed in response to vibrations from male spiders and leaves. Peak frequency and duration of vibrations generated by bugs were similar to those generated by prey and courting males. Further, vibrations from bugs had a temporal structure and amplitude that were similar to vibrations generated by leg and body movements of prey and distinctly different to vibrations from courting males or leaves, or prey beating their wings. To be an effective predator, bugs do not need to mimic the full range of prey vibrations. Instead bugs are general mimics of a subset of prey vibrations that fall within the range of vibrations classified by spiders as `prey'.},
  keywords = {aggressive mimicry,lure,Stenolemus bituberus,vibration,web-building spiders},
  file = {C:\Users\Amy Van Cise\Zotero\storage\YXPCFVQT\Wignall and Taylor - 2011 - Assassin bug uses aggressive mimicry to lure spide.pdf}
}

@article{wild_etal19,
