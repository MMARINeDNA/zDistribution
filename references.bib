@article{Guo2006,
  title = {Genetic Similarity Shared by Best Friends among Adolescents.},
  author = {Guo, Guang},
  year = 2006,
  journal = {Twin research and human genetics : the official journal of the International Society for Twin Studies},
  volume = {9},
