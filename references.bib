@article{Neuweiler1989,
  ids = {neuweilerForagingEcologyAudition1989,neuweilerForagingEcologyAudition1989a},
  title = {Foraging Ecology and Audition in Echolocating Bats},
  author = {Neuweiler, Gerhard},
  year = 1989,
