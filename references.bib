@article{fagan_etal20,
  title = {Improved Foraging by Switching between Diffusion and Advection: Benefits from Movement That Depends on Spatial Context},
  shorttitle = {Improved Foraging by Switching between Diffusion and Advection},
  author = {Fagan, William F. and Hoffman, Tyler and Dahiya, Daisy and Gurarie, Eliezer and Cantrell, Robert Stephen and Cosner, Chris},
  year = 2020,
  month = jun,
  journal = {Theoretical Ecology},
  volume = {13},
