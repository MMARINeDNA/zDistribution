@article{Holtby1989,
  title = {Stream Temperatures and Inter-Annual Variability in the Emigration Timing of Coho Salmon ({{{\emph{Oncorhynchus}}}}{\emph{ Kisutch}}) Smolts and Fry and Chum Salmon ({{{\emph{O}}}}{\emph{. Keta}}) Fry {{Carnation Creek}}, {{British Columbia}}},
