@article{barta_etal14,
  title = {Mitochondrial {{DNA}} Preservation across 3000-Year-Old Northern Fur Seal Ribs Is Not Related to Bone Density: {{Implications}} for Forensic Investigations},
  shorttitle = {Mitochondrial {{DNA}} Preservation across 3000-Year-Old Northern Fur Seal Ribs Is Not Related to Bone Density},
  author = {Barta, Jodi Lynn and Monroe, Cara and Crockford, Susan J. and Kemp, Brian M.},
  year = 2014,
  month = jun,
  journal = {Forensic Science International},
  volume = {239},
  pages = {11--18},
  issn = {1872-6283},
  doi = {10.1016/j.forsciint.2014.02.029},
  abstract = {While recent forensic research has focused on determining which skeletal elements are superior in their preservation of DNA over the long term, little focus has been placed on measuring intra-element variation. Moreover, there is a general belief that dense (cortical) bone material will contain better-preserved DNA than does spongy (cancellous) bone. To address these ideas, quantitative PCR was used to estimate the degree of mitochondrial DNA (mtDNA) preservation variance across sections of 19 northern fur seal ribs (Callorhinus ursinus) that date to {$\sim$}3000 years before present. Further, we developed a measure called the "density index" that was used to gauge the relative densities of the rib sections studied here to determine if density was an appropriate predictor of preservation. The average preservation among the samples was significantly different (ANOVA, p=1.9\texttimes 10(-9)) with only 15\% of the total variance observed within samples. However, 12 of the 19 specimens ({$\sim$}63.2\%) exhibited at least an order of magnitude difference in mtDNA preservation across the whole. Regression of the amount of mtDNA extracted per gram of bone material against the density index of the bone from which it was extracted demonstrates no relationship between these variables (R(2)=0.03, p=0.28).},
  langid = {english},
  pmid = {24709029},
  keywords = {Ancient DNA,Animals,Bone density,Bone Density,DNA Mitochondrial,Forensic Anthropology,Fur Seals,Polymerase Chain Reaction,Quantitative PCR,Ribs}
}

@article{Bartumeus2005,
  title = {Animal {{Search Strategies}}: {{A Quantitative Random Walk Analysis}}},
  author = {Bartumeus, Frederic and Da Luz, M G E and Viswanatham, G M and Catalan, J},
  year = 2005,
  journal = {Ecological Society of America},
  volume = {86},
