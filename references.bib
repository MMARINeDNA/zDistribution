@article{Findlay1992,
  title = {The Distribution of Small Odontocete Cetaceans off the Coasts of {{South Africa}} and {{Namibia}}},
  author = {Findlay, K. P. and Best, P. B. and Ross, G. J.B. and Cockcroft, V. G.},
