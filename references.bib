@article{knowlton_etal22,
  title = {Fishing Gear Entanglement Threatens Recovery of Critically Endangered {{North Atlantic}} Right Whales},
  author = {Knowlton, Amy R. and Clark, James S. and Hamilton, Philip K. and Kraus, Scott D. and Pettis, Heather M. and Rolland, Rosalind M. and Schick, Robert S.},
  year = 2022,
