@article{espregueirathemudo_etal20,
  title = {Losing {{Genes}}: {{The Evolutionary Remodeling}} of {{Cetacea Skin}}},
  shorttitle = {Losing {{Genes}}},
  author = {Espregueira Themudo, Gon{\c c}alo and Alves, Lu{\'i}s Q. and Machado, Andr{\'e} M. and {Lopes-Marques}, M{\'o}nica and {da Fonseca}, Rute R. and Fonseca, Miguel and Ruivo, Raquel and Castro, L. Filipe C.},
  year = 2020,
  month = oct,
  journal = {Frontiers in Marine Science},
  volume = {7},
  publisher = {Frontiers},
  issn = {2296-7745},
  doi = {10.3389/fmars.2020.592375},
  urldate = {2025-11-10},
  abstract = {The skin is a multi-layered organ, often displaying associated structures, that establishes a protective interface between the organism and the surrounding environment. In mammals, the skin provides a physical and immune barrier, while contributing to thermoregulation and water balance. Within cetaceans, the archetypal mammalian skin was drastically reshaped and remodelled, emerging as a striking feature of their successful adaptation to a fully aquatic lifestyle. In fact, cetacean skin is extremely thick, displays a high cellular turnover rate, and lacks typical mammalian pelages, as well as sebaceous glands, resulting in a smooth and drag-reducing skin. Curiously, at the genome level, the majority of cetacean skin-related innovations resulted from episodes of gene loss: spanning diverse processes such as skin keratinization and cornification, immunity and inflammation or lubrication. Here, we review how cetacean skin was shaped by such an evolutionary mechanism, by describing the full set of genes with inactivating mutations in the various functional compartments of the skin.},
  langid = {english},
  keywords = {Cetacea,gene loss,Genome,lossOme,Skin},
  file = {C:\Users\Amy Van Cise\Zotero\storage\8IRUXL5Q\Espregueira Themudo et al. - 2020 - Losing Genes The Evolutionary Remodeling of Cetacea Skin.pdf}
}

