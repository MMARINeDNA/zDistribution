@article{Benoit-Bird2016,
  title = {Predator-Guided Sampling Reveals Biotic Structure in the Bathypelagic.},
  author = {{Benoit-Bird}, Kelly J and Southall, Brandon L and Moline, Mark A},
  year = 2016,
  month = feb,
  journal = {Proceedings. Biological sciences},
  volume = {283},
