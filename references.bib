@article{Pespeni2013,
  title = {Signals of Selection in Outlier Loci in a Widely Dispersing Species across an Environmental Mosaic.},
  author = {Pespeni, Melissa H and Palumbi, Stephen R},
  year = 2013,
  month = jul,
  journal = {Molecular ecology},
  volume = {22},
