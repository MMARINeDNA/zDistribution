@article{Caraco1975,
  title = {Ecological {{Determinants}} of {{Group Sizes}} of {{Foraging Lions}}},
  author = {Caraco, Thomas and Wolf, Larry L.},
  year = 1975,
  journal = {The American Naturalist},
  volume = {109},
