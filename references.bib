@article{pinela_etal11,
  title = {Common Dolphin Morphotypes: {{Niche}} Segregation or Taxonomy?},
  author = {Pinela, A. M. and Borrell, A. and Aguilar, A.},
  year = 2011,
  month = aug,
  journal = {Journal of Zoology},
  volume = {284},
  number = {4},
  pages = {239--247},
  issn = {09528369},
  doi = {10.1111/J.1469-7998.2011.00798.X},
  urldate = {2023-03-30},
  abstract = {In the extensive geographical distribution of the common dolphin, several morphotypes of uncertain taxonomic status, identified by the relative length of their rostra, have been established. We investigated variation in skull morphometrics and isotopic signatures of carbon and nitrogen ({$\delta$} 13C and {$\delta$} 15N) in individuals from the subtropical waters of the North Atlantic Ocean, in order to assess population structure and taxonomic status. The distribution of the relative rostral lengths (RL) of individuals followed a cline with no subgrouping. Both {$\delta$} 13C and {$\delta$} 15N showed high variability, which suggests that individuals use habitat heterogeneously. {$\delta$} 15N correlated with RL, indicating that longer beaked individuals either feed at a higher trophic level and/or inhabit waters located further offshore than shorter beaked animals. Although {$\delta$} 13C and {$\delta$} 15N were correlated, RL and {$\delta$} 13C failed to show any correlation, possibly because the incremental effect of trophic level on {$\delta$} 13C has been offset by the potential allopatric distribution of the morphotypes. We conclude that both the long-beaked and short-beaked forms of common dolphin do occur off Mauritania but, in contrast to other areas, the existence of more than one species in the region is questioned because both stable isotopes and skull morphometric appear to reflect differential use of habitat rather than taxonomy. Even though proposed previously by some authors, this is the first time that skull differentiation in common dolphins has been demonstrated to be likely due to niche segregation and not to speciation. This reveals that caution is needed when considering that long-beaked and short-beaked common dolphins from outside the eastern North Pacific fall into the taxonomic model described for this region. \copyright{} 2011 The Authors. Journal of Zoology \copyright{} 2011 The Zoological Society of London.},
  keywords = {Common dolphins,Habitat use,Skull morphometric,Stable isotopes,Taxonomy},
  file = {C:\Users\Amy Van Cise\Zotero\storage\SQWBKH6Z\full-text.pdf}
}

@article{pinfield_etal19,
