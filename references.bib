@article{Stocker2015,
  title = {Summary for {{Policymakers}}. {{In}}: {{Climate Change}} 2013: {{The Physical Science Basis}}. {{Contribution}} of {{Working Group I}} to the {{Fifth Assessment Report}} of the {{Intergovernmental Panel}} on {{Climate Change}}},
  author = {Stocker, T.F. and Qin, D. and Plattner, G.-K. and Tignor, M. and Allen, S.K. and Boschung, J. and Nauels, A. and Xia, Y. and Bex, V. and (eds.), P.M. Midgley},
