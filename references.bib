@article{lewin_eyre-walker25,
  title = {Estimates of the Mutation Rate per Year Can Explain Why the Molecular Clock Depends on Generation Time},
  author = {Lewin, Loveday and {Eyre-Walker}, Adam},
  year = 2025,
