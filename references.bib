@article{queheillalt_etal02,
  title = {The {{Exclusion}} of {{Rare Species}} from {{Community-Level Analyses}}},
  author = {Queheillalt, Dianna M. and Cain, James W. and Taylor, Denise E. and Morrison, Michael L. and Hoover, Stacia L. and {Tuatoo-Bartley}, Natasha and Rugge, Lourdes and Christopherson, Kirsten and Hulst, Miriam D. and Harris, Michael R. and Keough, Heather L.},
  year = 2002,
