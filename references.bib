  doi = {10.1016/j.tree.2020.04.002},
  urldate = {2024-09-03},
  abstract = {Infectious disease outbreaks emerged across the globe during the recent 2015--2016 El Ni\~no event, re-igniting research interest in how climate events influence disease dynamics. While the relationship between long-term warming and the transmission of disease-causing parasites has received substantial attention, we do not yet know how pulse heat events -- common phenomena in a warming world -- will alter parasite transmission. The effects of pulse warming on ecological and evolutionary processes are complex and context dependent, motivating research to understand how climate oscillations drive host health and disease. Here, we develop a framework for evaluating and predicting the effects of pulse warming on parasitic infection. Specifically, we synthesize how pulse heat stress affects hosts, parasites, and the ecological interactions between them.},
  keywords = {climate change,disease,El Nino,parasite,pulse warming},
