  langid = {english},
  keywords = {computational approach,divergent selection,genome scan,landscape genomics,linkage disequilibrium,local adaptation,molecular genecology,molecular techniques,neighbor matrices,population genomics,regression analysis,single nucleotide polymorphisms,spatial autocorrelation,species distributional data,temperature response},
