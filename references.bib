@article{OCorry-Crowe2010,
  title = {Population Genetic Structure and Evolutionary History of {{North Atlantic}} Beluga Whales ({{Delphinapterus}} Leucas) from {{West Greenland}}, {{Svalbard}} and the {{White Sea}}},
  author = {{O'Corry-Crowe}, Gregory and Lydersen, Christian and {Heide-Jorgensen}, M P and Hansen, Lauren and Mukhametov, Lev M. and Dove, Outi and Kovacs, Kit M. and {Heide-J{\o}rgensen}, Mads Peter and Hansen, Lauren and Mukhametov, Lev M. and Dove, Outi and Kovacs, Kit M.},
  year = 2010,
  journal = {Polar Biology},
  volume = {33},
  number = {9},
  pages = {1179--1194},
  issn = {07224060},
  doi = {DOI 10.1007/s00300-010-0807-y},
  abstract = {Population structure in many Arctic marine mammal species reflects a\textbackslash r\textbackslash n   dynamic interplay between physical isolating mechanisms and the extent\textbackslash r\textbackslash n   to which dispersal opportunities are met. We examined variation within\textbackslash r\textbackslash n   mtDNA and eight microsatellite markers to investigate population\textbackslash r\textbackslash n   structure and demographic history in beluga whales in the North\textbackslash r\textbackslash n   Atlantic. Genetic heterogeneity was observed between Svalbard and West\textbackslash r\textbackslash n   Greenland that reveals limited gene flow over ecological time scales.\textbackslash r\textbackslash n   Differentiation was also recorded between Atlantic belugas and two\textbackslash r\textbackslash n   previously studied populations in the North Pacific, the Beaufort Sea\textbackslash r\textbackslash n   and Gulf of Alaska. However, Bayesian cluster analysis of the nDNA data\textbackslash r\textbackslash n   identified two population clusters that did not correspond to the\textbackslash r\textbackslash n   respective ocean basins, as predicted, but to: (1) Arctic\textbackslash r\textbackslash n   (Svalbard-White Sea-Greenland-Beaufort Sea) and (2) Subarctic (Gulf of\textbackslash r\textbackslash n   Alaska) regions. Similarly, the deepest phylogeographic signal was\textbackslash r\textbackslash n   between the Arctic populations and the Gulf of Alaska. Fitting an\textbackslash r\textbackslash n   isolation-with-migration model yielded genetic abundance estimates that\textbackslash r\textbackslash n   match census estimates and revealed that Svalbard and the Beaufort Sea\textbackslash r\textbackslash n   likely diverged 7,600-35,400 years ago but have experienced recurrent\textbackslash r\textbackslash n   periods with gene flow since then, most likely via the Russian Arctic\textbackslash r\textbackslash n   during subsequent warm periods. Considering current projections of\textbackslash r\textbackslash n   continued sea ice losses in the Arctic, this study identified likely\textbackslash r\textbackslash n   routes of future contact among extant beluga populations, and other\textbackslash r\textbackslash n   mobile marine species, which have implications for genetic\textbackslash r\textbackslash n   introgression, health, ecology and behavior.},
  isbn = {0722-4060\textbackslash n1432-2056},
  langid = {english},
  keywords = {american populations,autumn movements,beaufort sea,bowhead whales,climate,Climate,climate-change,coalescent approach,isolation with migration,Isolation with migration,maximum-likelihood-estimation,microsatellites,Microsatellites,migration rates,mitochondrial-DNA,mtdna,mtDNA,multilocus genotype data,population structure,Population structure,white whale,White whale},
  file = {C:\Users\Amy Van Cise\Zotero\storage\T5JVNYY9\O'Corry-Crowe et al. - 2010 - Population genetic structure and evolutionary history of North Atlantic beluga whales (Delphinapterus leuc.pdf}
}

@article{OCorry-Crowe2016,
  title = {Genetic Profiling Links Changing Sea-Ice to Shifting Beluga Whale Migration Patterns},
  author = {{O'Corry-Crowe}, Gregory and Mahoney, Andrew R and Suydam, Robert and Quakenbush, Lori and Whiting, Alex and Lowry, Lloyd and Harwood, Lois and {Corry-crowe}, Greg O},
  year = 2016,
  journal = {Biology letters},
  volume = {12},
  number = {20160404},
  pages = {0--4},
  issn = {1744-9561},
  doi = {10.1098/rsbl.2016.0404},
  abstract = {One contribution to the special feature 'Effects of sea ice on Arctic biota'. There is increasing concern over how Arctic fauna will adapt to climate related changes in sea-ice. We used long-term sighting and genetic data on beluga whales (Delphinapterus leucas) in conjunction with multi-decadal patterns of sea-ice in the Pacific Arctic to investigate the influence of sea-ice on spring migration and summer residency patterns. Substantial variations in sea-ice conditions were detected across seasons, years and sub-regions, revealing ice--ocean dynamics more complex than Arctic-wide trends suggest. This vari-ation contrasted with a highly consistent pattern of migration and residency by several populations, indicating that belugas can accommodate widely varying sea-ice conditions to perpetuate philopatry to coastal migration destinations. However, a number of anomalous migration and residency events were detected and coincided with anomalous ice years, and in one case with an increase in killer whale (Orcinus orca) sightings and reported predation on beluga whales. The behavioural shifts were likely driven by changing sea-ice and associated changes in resource dispersion and predation risk. Continued reductions in sea-ice may result in increased predation at key aggregation areas and shifts in beluga whale behaviour with implications for population viability, ecosystem structure and the subsistence cultures that rely on them.},
  keywords = {behaviour,ecology,environmental science},
  file = {C:\Users\Amy Van Cise\Zotero\storage\66FN5UFR\O'Corry-Crowe et al. 2016. genetic profiling links changing sea-ice to beluga migratory behavior.pdf}
}

@article{OCorry-Crowe2020,
  ids = {ocorry-croweGroupStructureKinship2020},
  title = {Group Structure and Kinship in Beluga Whale Societies},
  author = {{O'Corry-Crowe}, Greg and Suydam, Robert and Quakenbush, Lori and Smith, Thomas G. and Lydersen, Christian and Kovacs, Kit M. and Orr, Jack and Harwood, Lois and Litovka, Dennis and Ferrer, Tatiana},
  year = 2020,
  journal = {Scientific Reports},
  volume = {10},
  number = {1},
  pages = {1--21},
  publisher = {Nature Publishing Group UK},
  issn = {20452322},
  doi = {10.1038/s41598-020-67314-w},
  abstract = {Evolutionary explanations for mammalian sociality typically center on inclusive-fitness benefits of associating and cooperating with close kin, or close maternal kin as in some whale societies, including killer and sperm whales. Their matrilineal structure has strongly influenced the thinking about social structure in less well-studied cetaceans, including beluga whales. In a cross-sectional study of group structure and kinship we found that belugas formed a limited number of distinct group types, consistently observed across populations and habitats. Certain behaviours were associated with group type, but group membership was often dynamic. MtDNA-microsatellite profiling combined with relatedness and network analysis revealed, contrary to predictions, that most social groupings were not predominantly organized around close maternal relatives. They comprised both kin and non-kin, many group members were paternal rather than maternal relatives, and unrelated adult males often traveled together. The evolutionary mechanisms that shape beluga societies are likely complex; fitness benefits may be achieved through reciprocity, mutualism and kin selection. At the largest scales these societies are communities comprising all ages and both sexes where multiple social learning pathways involving kin and non-kin can foster the emergence of cultures. We explore the implications of these findings for species management and the evolution of menopause.},
  isbn = {0123456789},
  pmid = {32651398},
  keywords = {Ecology,Evolution},
  file = {C\:\\Users\\Amy Van Cise\\Zotero\\storage\\BAKPRH9M\\O’Corry-Crowe et al. - 2020 - Group structure and kinship in beluga whale societ.pdf;C\:\\Users\\Amy Van Cise\\Zotero\\storage\\DVCXKITZ\\O'Corry-Crowe et al 2020 - Scientific Reports.pdf;C\:\\Users\\Amy Van Cise\\Zotero\\storage\\NPE8ZSYS\\O’Corry-Crowe et al. - 2020 - Group structure and kinship in beluga whale societ.pdf}
}

