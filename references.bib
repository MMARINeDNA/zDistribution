@article{shelton_etal19,
  title = {Using Hierarchical Models to Estimate Stock-Specific and Seasonal Variation in Ocean Distribution, Survivorship, and Aggregate Abundance of Fall Run Chinook Salmon},
  author = {Shelton, Andrew Olaf and Satterthwaite, William H. and Ward, Eric J. and Feist, Blake E. and Burke, Brian},
  year = 2019,
  journal = {Canadian Journal of Fisheries and Aquatic Sciences},
  volume = {76},
  number = {1},
