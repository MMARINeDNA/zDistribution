@article{devos_etal18,
  title = {New {{Determination}} of {{Prey}} and {{Parasite Species}} for {{Northern Indian Ocean Blue Whales}}},
  author = {{de Vos}, Asha and Faux, Cassandra E. and Marthick, James and Dickinson, Joanne and Jarman, Simon N.},
