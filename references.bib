@article{Archer2019a,
  title = {Revision of Fin Whale {{{\emph{Balaenoptera}}}}{\emph{ Physalus}} ({{Linnaeus}}, 1758) Subspecies Using Genetics},
  author = {Archer, Frederick I and Brownell, Robert L and {Hancock-Hanser}, Brittany L and Morin, Phillip A and Robertson, Kelly M and Sherman, Kathryn K and Calambokidis, John and Urb{\'a}n R, Jorge and Rosel, Patricia E and Mizroch, Sally A and Panigada, Simone and Taylor, Barbara L},
