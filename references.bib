@article{Hasegawa1985,
  title = {Dating of the Human-Ape Splitting by a Molecular Clock of Mitochondrial {{DNA}}},
  author = {Hasegawa, Masami and Kishino, Hirohisa and Yano, Taka Aki},
  year = 1985,
  journal = {Journal of Molecular Evolution},
  volume = {22},
  number = {2},
  pages = {160--174},
  issn = {00222844},
  doi = {10.1007/BF02101694},
  abstract = {Summary A new statistical method for estimating divergence dates of species from DNA sequence data by a molecular clock approach is developed. This method takes into account effectively the information contained in a set of DNA sequence data. The molecular clock of mitochondrial DNA (mtDNA) was calibrated by setting the date of divergence between primates and ungulates at the Cretaceous-Tertiary boundary (65 million years ago), when the extinction of dinosaurs occurred. A generalized leastsquares method was applied in fitting a model to mtDNA sequence data, and the clock gave dates of 92.3\textpm 11.7, 13.3\textpm 1.5, 10.9\textpm 1.2, 3.7\textpm 0.6, and 2.7\textpm 0.6 million years ago (where the second of each pair of numbers is the standard deviation) for the separation of mouse, gibbon, orangutan, gorilla, and chimpanzee, respectively, from the line leading to humans. Although there is some uncertainty in the clock, this dating may pose a problem for the widely believed hypothesis that the bipedal creatureAustralopithecus afarensis, which lived some 3.7 million years ago at Laetoli in Tanzania and at Hadar in Ethiopia, was ancestral to man and evolved after the human-ape splitting. Another likelier possibility is that mtDNA was transferred through hybridization between a proto-human and a protochimpanzee after the former had developed bipedalism.},
  isbn = {0022-2844},
  pmid = {3934395},
  keywords = {Evolution of hominoids,Interspecies transfer of mitochondrial DNA,Phylogenetic position of Australopithecus afarensi},
  file = {C:\Users\Amy Van Cise\Zotero\storage\B9UHT936\Hasegawa et al. 1985. dating of human-ape splitting using a molecular clock.pdf}
}

