@article{fang_etal16,
  title = {Analytical Techniques for Steroid Estrogens in Water Samples - {{A}} Review},
  author = {Fang, Ting Yien and Praveena, Sarva Mangala and {deBurbure}, Claire and Aris, Ahmad Zaharin and Ismail, Sharifah Norkhadijah Syed and Rasdi, Irniza},
  year = 2016,
