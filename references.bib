@article{Sharon2019,
  title = {Human Gut Microbiota from Autism Spectrum Disorder Promote Behavioral Symptoms in Mice},
  author = {Sharon, Gil and Cruz, Nikki Jamie and Kang, Dae Wook and Gandal, Michael J. and Wang, Bo and Kim, Young Mo and Zink, Erika M. and Casey, Cameron P. and Taylor, Bryn C. and Lane, Christianne J. and Bramer, Lisa M. and Isern, Nancy G. and Hoyt, David W. and Noecker, Cecilia and Sweredoski, Michael J. and Moradian, Annie and Borenstein, Elhanan and Jansson, Janet K. and Knight, Rob and Metz, Thomas O. and Lois, Carlos and Geschwind, Daniel H. and {Krajmalnik-Brown}, Rosa and Mazmanian, Sarkis K.},
  year = 2019,
