@article{Mansouri2021,
  title = {Evidence of Multi-Decadal Behavior and Ecosystem-Level Changes Revealed by Reconstructed Lifetime Stable Isotope Profiles of Baleen Whale Earplugs},
  author = {Mansouri, Farzaneh and Winfield, Zach C. and Crain, Danielle D. and Morris, Brooke and Charapata, Patrick and Sabin, Richard and Potter, Charles W. and Hering, Amanda S. and Fulton, James and Trumble, Stephen J. and Usenko, Sascha},
  year = 2021,
  month = feb,
  journal = {Science of The Total Environment},
  volume = {757},
  pages = {143985},
  issn = {00489697},
  doi = {10.1016/j.scitotenv.2020.143985},
  abstract = {Biological time series datasets provide an unparalleled opportunity to investigate regional and global changes in the marine environment. Baleen whales are long-lived sentinel species and an integral part of the marine ecosystem. Increasing anthropogenic terrestrial and marine activities alter ocean systems, and such alterations could change foraging and feeding behavior of baleen whales. In this study, we analyzed {$\delta$}13C and {$\delta$}15N of baleen whale earplugs from three different species (N = 6 earplugs, n = 337 laminae) to reconstruct the first continuous stable isotope profiles with a six-month resolution. Results of our study provide an unprecedented opportunity to assess behavioral as well as ecological changes. Abrupt shifts and temporal variability observed in {$\delta$}13C and {$\delta$}15N profiles could be indicative of behavior change such as shift in foraging location and/or trophic level in response to natural or anthropogenic disturbances. Additionally, five out of six individuals demonstrated long-term declining trends in {$\delta$}13C profiles, which could suggest influence of emission of depleted 13CO2 from fossil fuel combustion referred to as the Suess effect. After adjusting the {$\delta$}13C values of earplugs for the estimated Suess effect and re-evaluating {$\delta$}13C profiles, significant decline in {$\delta$}13C values as well as different rate of depletion suggest contribution of other sources that could impact {$\delta$}13C values at the base of the food web.},
  pmid = {33321341},
  keywords = {13C,15N,Blue,Earplug,Fin,Humpback},
  file = {C:\Users\Amy Van Cise\Zotero\storage\R745N6P7\1-s2.0-S0048969720375161-main.pdf}
}

