  pages = {9},
  issn = {2056-306X},
  doi = {10.1186/s40851-014-0002-z},
  urldate = {2025-11-10},
  abstract = {While olfaction is one of the most important senses in most terrestrial mammals, it is absent in modern toothed whales (Odontoceti, Cetacea). Furthermore, behavioral evidence suggests that gustation is very limited. In contrast, their aquatic sistergroup, baleen whales (Mysticeti) retain small but functional olfactory organs, and nothing is known about their gustation. It is difficult to investigate mysticete chemosensory abilities because experiments in a controlled setting are impossible.},
  keywords = {Antarctic minke whale genome,Archaeoceti,Cetacea,Chemoreception,Olfactory bulb},
