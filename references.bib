@article{reyes-arias_etal23,
  title = {Vocalizations of Wild {{West Indian}} Manatee Vary across Subspecies and Geographic Location},
  author = {{Reyes-Arias}, Jessica D. and Brady, Beth and Ramos, Eric A. and Henaut, Yann and {Castelblanco-Mart{\'i}nez}, Delma Nataly and {Maust-Mohl}, Maria and Searle, Linda and {P{\'e}rez-Lachaud}, Gabriela and Guzm{\'a}n, H{\'e}ctor M. and Poveda, H{\'e}ctor and Merchan, Fernando and Contreras, Kenji and {Sanchez-Galan}, Javier E. and Collom, Kristi A. and Magnasco, Marcelo O.},
