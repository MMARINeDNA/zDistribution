  author = {Qu{\'e}rouil, Sophie and Silva, M{\'o}nica A. and Freitas, Lu{\'i}s and Prieto, Rui and Magalh{\~a}es, Sara and Dinis, Ana and Alves, Filipe and Matos, Jos{\'e} A. and Mendon{\c c}a, Diogo and Hammond, Philip S. and Santos, Ricardo S.},
  year = 2007,
