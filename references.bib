@article{kucukyildirim_etal20,
  title = {Estimation of the {{Genome-Wide Mutation Rate}} and {{Spectrum}} in the {{Archaeal Species Haloferax}} Volcanii},
  author = {Kucukyildirim, Sibel and Behringer, Megan and Williams, Emily M. and Doak, Thomas G. and Lynch, Michael},
