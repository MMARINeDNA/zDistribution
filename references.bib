@article{Kanaji2011,
  title = {Long-Term Abundance Trends of the Northern Form of the Short-Finned Pilot Whale ({{Globicephala}} Macrorhynchus) along the {{Pacific}} Coast of {{Japan}}},
  author = {Kanaji, Y and Okamura, H and Miyashita, T},
