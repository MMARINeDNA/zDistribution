  title = {Antarctic Ice-Shelf Calving Triggered by the {{Honshu}} ({{Japan}}) Earthquake and Tsunami, {{March}} 2011},
  author = {Brunt, Kelly M and Okal, Emile A and MacAyeal, Douglas R},
  year = 2011,
  journal = {Journal of Glaciology},
  volume = {57},
  number = {205},
