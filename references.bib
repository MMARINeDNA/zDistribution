  author = {Chen, I-Hua and Chou, Lien-Siang and Chou, Shih-Jen and Wang, Jiann-Hsiung and Stott, Jeffrey and Blanchard, Myra and Jen, I-Fan and Yang, Wei-Cheng},
  year = 2015,
