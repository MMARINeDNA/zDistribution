@article{Drummond2012,
  title = {Bayesian Phylogenetics with {{BEAUti}} and the {{BEAST}} 1.7},
  author = {Drummond, Alexei J. and a. Suchard, Marc and Xie, Dong and Rambaut, Andrew},
